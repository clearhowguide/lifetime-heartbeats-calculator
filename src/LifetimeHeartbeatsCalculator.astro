---
const {
  sharePath = '/en/science/lifetime-heartbeats-calculator/',
} = Astro.props;
---

<section
  class="lhc"
  data-lhc
  data-share-path={sharePath}
  aria-label="Lifetime Heartbeats Calculator"
>
  <div class="lhc__header">
    <p class="lhc__eyebrow">Interactive science tool</p>

    <p class="lhc__title">
      Explore the math behind the one-billion-heartbeats idea
    </p>

    <p class="lhc__intro">
      Estimate how many times a heart would beat over a given number of years,
      or convert a heartbeat total into an equivalent amount of time.
    </p>
  </div>

  <div class="lhc__privacy" role="note">
    <strong>Private by design:</strong>
    calculations happen entirely in your browser. Nothing you enter is sent to
    PocketBase or another server.
  </div>

  <div
    class="lhc__tabs"
    role="tablist"
    aria-label="Calculator mode"
  >
    <button
      type="button"
      class="lhc__tab is-active"
      role="tab"
      aria-selected="true"
      tabindex="0"
      data-mode-button="estimate"
    >
      Estimate lifetime heartbeats
    </button>

    <button
      type="button"
      class="lhc__tab"
      role="tab"
      aria-selected="false"
      tabindex="-1"
      data-mode-button="convert"
    >
      Heartbeats → years
    </button>
  </div>

  <div
    class="lhc__mode-panel"
    role="tabpanel"
    data-mode-panel="estimate"
  >
    <form data-estimate-form novalidate>
      <div class="lhc__fields">
        <label class="lhc__field">
          <span class="lhc__label">Heart rate</span>

          <span class="lhc__input-wrap">
            <input
              data-estimate-bpm
              type="number"
              min="1"
              max="2000"
              step="0.1"
              value="70"
              inputmode="decimal"
              required
            />
            <span class="lhc__unit">bpm</span>
          </span>

          <span class="lhc__field-hint">
            Allowed range: 1–2,000 bpm
          </span>
        </label>

        <label class="lhc__field">
          <span class="lhc__label">Lifespan</span>

          <span class="lhc__input-wrap">
            <input
              data-estimate-years
              type="number"
              min="0.01"
              max="300"
              step="0.01"
              value="80"
              inputmode="decimal"
              required
            />
            <span class="lhc__unit">years</span>
          </span>

          <span class="lhc__field-hint">
            Allowed range: 0.01–300 years
          </span>
        </label>
      </div>

      <button type="submit" class="lhc__primary-button">
        Calculate lifetime heartbeats
      </button>
    </form>
  </div>

  <div
    class="lhc__mode-panel"
    role="tabpanel"
    data-mode-panel="convert"
    hidden
  >
    <form data-convert-form novalidate>
      <div class="lhc__fields">
        <label class="lhc__field">
          <span class="lhc__label">Total heartbeats</span>

          <span class="lhc__input-wrap">
            <input
              data-convert-beats
              type="text"
              inputmode="numeric"
              value="1,000,000,000"
              autocomplete="off"
              required
            />
            <span class="lhc__unit">beats</span>
          </span>

          <span class="lhc__field-hint">
            Allowed range: 1–100 billion
          </span>
        </label>

        <label class="lhc__field">
          <span class="lhc__label">Heart rate</span>

          <span class="lhc__input-wrap">
            <input
              data-convert-bpm
              type="number"
              min="1"
              max="2000"
              step="0.1"
              value="60"
              inputmode="decimal"
              required
            />
            <span class="lhc__unit">bpm</span>
          </span>

          <span class="lhc__field-hint">
            Allowed range: 1–2,000 bpm
          </span>
        </label>
      </div>

      <button type="submit" class="lhc__primary-button">
        Convert heartbeats to time
      </button>
    </form>
  </div>

  <p class="lhc__error" data-error role="alert" hidden></p>

  <div class="lhc__presets">
    <p class="lhc__presets-title">Try an illustrative example</p>

    <div class="lhc__preset-grid">
      <button
        type="button"
        class="lhc__preset"
        data-preset-mode="estimate"
        data-preset-bpm="30"
        data-preset-years="65"
      >
        <strong>Elephant example</strong>
        <span>30 bpm · 65 years</span>
      </button>

      <button
        type="button"
        class="lhc__preset"
        data-preset-mode="estimate"
        data-preset-bpm="70"
        data-preset-years="80"
      >
        <strong>Human example</strong>
        <span>70 bpm · 80 years</span>
      </button>

      <button
        type="button"
        class="lhc__preset"
        data-preset-mode="convert"
        data-preset-bpm="60"
        data-preset-beats="1000000000"
      >
        <strong>1 billion at 60 bpm</strong>
        <span>How long would it take?</span>
      </button>

      <button
        type="button"
        class="lhc__preset"
        data-preset-mode="convert"
        data-preset-bpm="60"
        data-preset-beats="2000000000"
      >
        <strong>2 billion at 60 bpm</strong>
        <span>How many years?</span>
      </button>
    </div>
  </div>

  <section
    class="lhc__result"
    data-result
    aria-live="polite"
    aria-atomic="true"
  >
    <p class="lhc__result-kicker" data-result-kicker>
      Estimated lifetime heartbeats
    </p>

    <p class="lhc__result-primary" data-result-primary>
      ≈ 2.95 billion heartbeats
    </p>

    <p class="lhc__result-explanation" data-result-explanation>
      At a constant 70 bpm over 80 years, the mathematical estimate is about
      2.95 billion heartbeats.
    </p>

    <p class="lhc__result-exact" data-result-exact>
      Exact mathematical result: 2,945,376,000 heartbeats
    </p>

    <div class="lhc__comparison" aria-label="Comparison with one billion heartbeats">
      <div class="lhc__comparison-header">
        <strong>Where does the result sit?</strong>
        <span data-scale-caption>
          1 billion reference · Your estimate: 2.95 billion
        </span>
      </div>

      <div class="lhc__scale">
        <div class="lhc__scale-track">
          <span
            class="lhc__marker lhc__marker--reference"
            data-scale-reference
            style="left: 33.333%;"
          >
            <span>1B</span>
          </span>

          <span
            class="lhc__marker lhc__marker--result"
            data-scale-result
            style="left: 98%;"
          >
            <span>Your result</span>
          </span>
        </div>

        <div class="lhc__scale-labels">
          <span>0</span>
          <span data-scale-max>3 billion</span>
        </div>
      </div>
    </div>

    <div class="lhc__scenarios">
      <div class="lhc__scenarios-header">
        <strong>What happens if the heart beats faster or slower?</strong>
        <p data-scenarios-intro>
          Same lifespan, different constant heart rates.
        </p>
      </div>

      <div class="lhc__scenario-grid" data-scenario-grid></div>
    </div>

    <div class="lhc__meaning">
      <strong>What does this number actually mean?</strong>

      <p>
        The calculation assumes the same heart rate every minute of every day.
        Real mammalian heart rates change with activity, sleep, age,
        temperature, stress, diving, torpor and other physiological states.
      </p>

      <p>
        <strong>
          Use this as a mathematical comparison, not as a prediction of lifespan.
        </strong>
      </p>

      <a
        href="/en/science/one-billion-heartbeats-mammals/#is-there-really-a-fixed-heartbeat-budget"
      >
        Why the one-billion-heartbeats rule is only an approximation →
      </a>
    </div>

    <div class="lhc__actions">
      <button
        type="button"
        class="lhc__secondary-button"
        data-copy-result
        disabled
      >
        Copy result
      </button>

      <button
        type="button"
        class="lhc__secondary-button"
        data-share-result
        disabled
      >
        Share calculation
      </button>
    </div>

    <p
      class="lhc__action-status"
      data-action-status
      role="status"
      aria-live="polite"
    ></p>
  </section>

  <details class="lhc__method">
    <summary>How the calculator works</summary>

    <div class="lhc__method-content">
      <p><strong>Estimate lifetime heartbeats</strong></p>

      <code>
        Lifetime heartbeats = heart rate × 60 × 24 × 365.25 × years
      </code>

      <p><strong>Convert heartbeats to equivalent years</strong></p>

      <code>
        Equivalent years = total heartbeats ÷ heart rate ÷ 60 ÷ 24 ÷ 365.25
      </code>

      <p>
        The calculator uses 365.25 days per year and assumes a constant heart
        rate solely for mathematical comparison.
      </p>
    </div>
  </details>

  <div class="lhc__disclaimer" role="note">
    <strong>Important:</strong>
    this is a mathematical estimate, not a prediction of lifespan and not a
    medical heart-rate assessment.
  </div>
</section>

<script>
  const MINUTES_PER_YEAR = 60 * 24 * 365.25;
  const ONE_BILLION = 1_000_000_000;

  const LIMITS = {
    bpmMin: 1,
    bpmMax: 2000,
    yearsMin: 0.01,
    yearsMax: 300,
    beatsMin: 1,
    beatsMax: 100_000_000_000,
  };

  const decimalFormatter = new Intl.NumberFormat('en-US', {
    maximumFractionDigits: 2,
  });

  const preciseFormatter = new Intl.NumberFormat('en-US', {
    maximumFractionDigits: 4,
  });

  const integerFormatter = new Intl.NumberFormat('en-US', {
    maximumFractionDigits: 0,
  });

  function parseLooseNumber(value) {
    return Number(
      String(value)
        .trim()
        .replace(/[,\s_]/g, '')
    );
  }

  function formatDecimal(value, digits = 2) {
    return new Intl.NumberFormat('en-US', {
      maximumFractionDigits: digits,
    }).format(value);
  }

  function formatCompactNumber(value) {
    const absolute = Math.abs(value);

    if (absolute >= 1_000_000_000) {
      return `${decimalFormatter.format(value / 1_000_000_000)} billion`;
    }

    if (absolute >= 1_000_000) {
      return `${decimalFormatter.format(value / 1_000_000)} million`;
    }

    if (absolute >= 1_000) {
      return `${decimalFormatter.format(value / 1_000)} thousand`;
    }

    return decimalFormatter.format(value);
  }

  function formatExactBeats(value) {
    return integerFormatter.format(Math.round(value));
  }

  function formatDetailedDuration(years) {
    if (!Number.isFinite(years) || years < 0) {
      return 'unknown duration';
    }

    let wholeYears = Math.floor(years);
    const fractionalYears = years - wholeYears;

    let monthFloat = fractionalYears * 12;
    let months = Math.floor(monthFloat);

    const remainingMonthFraction = monthFloat - months;
    let days = Math.round(
      remainingMonthFraction * (365.25 / 12)
    );

    if (days >= 30) {
      days = 0;
      months += 1;
    }

    if (months >= 12) {
      months = 0;
      wholeYears += 1;
    }

    const parts = [];

    if (wholeYears > 0) {
      parts.push(
        `${wholeYears} ${wholeYears === 1 ? 'year' : 'years'}`
      );
    }

    if (months > 0) {
      parts.push(
        `${months} ${months === 1 ? 'month' : 'months'}`
      );
    }

    if (days > 0) {
      parts.push(
        `${days} ${days === 1 ? 'day' : 'days'}`
      );
    }

    if (parts.length === 0) {
      const totalDays = years * 365.25;

      return `${formatDecimal(totalDays, 2)} days`;
    }

    return parts.join(', ');
  }

  function formatYearsPrimary(years) {
    if (years >= 1) {
      return `${formatDecimal(years, 2)} years`;
    }

    const months = years * 12;

    if (months >= 1) {
      return `${formatDecimal(months, 2)} months`;
    }

    return `${formatDecimal(years * 365.25, 2)} days`;
  }

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function niceRate(value) {
    if (value < 10) {
      return Math.round(value * 10) / 10;
    }

    if (value < 100) {
      return Math.round(value / 5) * 5;
    }

    return Math.round(value / 10) * 10;
  }

  function getScenarioRates(bpm) {
    let lower = clamp(
      niceRate(bpm * 0.7),
      LIMITS.bpmMin,
      LIMITS.bpmMax
    );

    let higher = clamp(
      niceRate(bpm * 1.4),
      LIMITS.bpmMin,
      LIMITS.bpmMax
    );

    if (lower >= bpm) {
      lower = clamp(
        niceRate(bpm * 0.8),
        LIMITS.bpmMin,
        LIMITS.bpmMax
      );
    }

    if (higher <= bpm) {
      higher = clamp(
        niceRate(bpm * 1.2),
        LIMITS.bpmMin,
        LIMITS.bpmMax
      );
    }

    return [...new Set([lower, bpm, higher])];
  }

  function copyToClipboard(text) {
    if (navigator.clipboard?.writeText) {
      return navigator.clipboard.writeText(text);
    }

    return new Promise((resolve, reject) => {
      const textarea = document.createElement('textarea');

      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';

      document.body.appendChild(textarea);

      textarea.select();

      const success = document.execCommand('copy');

      textarea.remove();

      if (success) {
        resolve();
      } else {
        reject(new Error('Copy failed'));
      }
    });
  }

  function initCalculator(root) {
    if (root.dataset.lhcReady === 'true') {
      return;
    }

    root.dataset.lhcReady = 'true';

    const modeButtons = [
      ...root.querySelectorAll('[data-mode-button]'),
    ];

    const modePanels = [
      ...root.querySelectorAll('[data-mode-panel]'),
    ];

    const estimateForm =
      root.querySelector('[data-estimate-form]');

    const convertForm =
      root.querySelector('[data-convert-form]');

    const estimateBpm =
      root.querySelector('[data-estimate-bpm]');

    const estimateYears =
      root.querySelector('[data-estimate-years]');

    const convertBeats =
      root.querySelector('[data-convert-beats]');

    const convertBpm =
      root.querySelector('[data-convert-bpm]');

    const errorElement =
      root.querySelector('[data-error]');

    const resultKicker =
      root.querySelector('[data-result-kicker]');

    const resultPrimary =
      root.querySelector('[data-result-primary]');

    const resultExplanation =
      root.querySelector('[data-result-explanation]');

    const resultExact =
      root.querySelector('[data-result-exact]');

    const scaleReference =
      root.querySelector('[data-scale-reference]');

    const scaleResult =
      root.querySelector('[data-scale-result]');

    const scaleMax =
      root.querySelector('[data-scale-max]');

    const scaleCaption =
      root.querySelector('[data-scale-caption]');

    const scenarioGrid =
      root.querySelector('[data-scenario-grid]');

    const scenariosIntro =
      root.querySelector('[data-scenarios-intro]');

    const copyButton =
      root.querySelector('[data-copy-result]');

    const shareButton =
      root.querySelector('[data-share-result]');

    const actionStatus =
      root.querySelector('[data-action-status]');

    let currentResult = null;
    let statusTimer = 0;

    function announce(message) {
      if (!actionStatus) {
        return;
      }

      actionStatus.textContent = message;

      window.clearTimeout(statusTimer);

      statusTimer = window.setTimeout(() => {
        actionStatus.textContent = '';
      }, 4000);
    }

    function clearError() {
      if (!errorElement) {
        return;
      }

      errorElement.hidden = true;
      errorElement.textContent = '';
    }

    function showError(message) {
      if (!errorElement) {
        return;
      }

      errorElement.textContent = message;
      errorElement.hidden = false;
    }

    function setMode(mode, focusInput = false) {
      for (const button of modeButtons) {
        const active = button.dataset.modeButton === mode;

        button.classList.toggle('is-active', active);
        button.setAttribute(
          'aria-selected',
          active ? 'true' : 'false'
        );

        button.tabIndex = active ? 0 : -1;
      }

      for (const panel of modePanels) {
        panel.hidden = panel.dataset.modePanel !== mode;
      }

      root.dataset.mode = mode;

      if (focusInput) {
        const activePanel = root.querySelector(
          `[data-mode-panel="${mode}"]`
        );

        activePanel?.querySelector('input')?.focus();
      }

      clearError();
    }

    function validateNumber(
      value,
      min,
      max,
      label
    ) {
      if (!Number.isFinite(value)) {
        throw new Error(`${label} must be a number.`);
      }

      if (value < min || value > max) {
        throw new Error(
          `${label} must be between ${min} and ${integerFormatter.format(max)}.`
        );
      }

      return value;
    }

    function buildShareUrl(result) {
      const sharePath =
        root.dataset.sharePath ||
        '/en/science/lifetime-heartbeats-calculator/';

      const url = new URL(
        sharePath,
        window.location.origin
      );

      url.searchParams.set('mode', result.mode);
      url.searchParams.set('bpm', String(result.bpm));

      if (result.mode === 'estimate') {
        url.searchParams.set(
          'years',
          String(result.years)
        );
      } else {
        url.searchParams.set(
          'beats',
          String(Math.round(result.beats))
        );
      }

      return url.toString();
    }

    function renderScale(beats) {
      const scaleMaximum = Math.max(
        3 * ONE_BILLION,
        Math.ceil(beats / ONE_BILLION) * ONE_BILLION
      );

      const resultPosition = clamp(
        (beats / scaleMaximum) * 100,
        1.5,
        98.5
      );

      const referencePosition = clamp(
        (ONE_BILLION / scaleMaximum) * 100,
        1.5,
        98.5
      );

      if (scaleResult) {
        scaleResult.style.left =
          `${resultPosition}%`;
      }

      if (scaleReference) {
        scaleReference.style.left =
          `${referencePosition}%`;
      }

      if (scaleMax) {
        scaleMax.textContent =
          formatCompactNumber(scaleMaximum);
      }

      if (scaleCaption) {
        scaleCaption.textContent =
          `1 billion reference · Your result: ${formatCompactNumber(beats)}`;
      }
    }

    function renderScenarios(result) {
      if (!scenarioGrid) {
        return;
      }

      scenarioGrid.replaceChildren();

      const rates = getScenarioRates(result.bpm);

      if (scenariosIntro) {
        scenariosIntro.textContent =
          result.mode === 'estimate'
            ? 'Same lifespan, different constant heart rates.'
            : 'Same heartbeat total, different constant heart rates.';
      }

      for (const rate of rates) {
        const card = document.createElement('div');
        const rateText = document.createElement('strong');
        const valueText = document.createElement('span');

        card.className = 'lhc__scenario';

        if (rate === result.bpm) {
          card.classList.add('is-current');
        }

        rateText.textContent =
          `${formatDecimal(rate, 1)} bpm`;

        if (result.mode === 'estimate') {
          const beats =
            rate *
            MINUTES_PER_YEAR *
            result.years;

          valueText.textContent =
            `${formatCompactNumber(beats)} heartbeats`;
        } else {
          const years =
            result.beats /
            (rate * MINUTES_PER_YEAR);

          valueText.textContent =
            formatYearsPrimary(years);
        }

        card.append(rateText, valueText);
        scenarioGrid.appendChild(card);
      }
    }

    function renderResult(result) {
      currentResult = result;
      clearError();

      const ratio = result.beats / ONE_BILLION;

      let comparisonText;

      if (ratio >= 0.85 && ratio <= 1.15) {
        comparisonText =
          'This falls remarkably close to the popular one-billion-heartbeats figure.';
      } else {
        comparisonText =
          `That is about ${formatDecimal(ratio, 2)}× the popular one-billion-heartbeats figure.`;
      }

      if (result.mode === 'estimate') {
        const compact =
          formatCompactNumber(result.beats);

        const exact =
          formatExactBeats(result.beats);

        if (resultKicker) {
          resultKicker.textContent =
            'Estimated lifetime heartbeats';
        }

        if (resultPrimary) {
          resultPrimary.textContent =
            `≈ ${compact} heartbeats`;
        }

        if (resultExplanation) {
          resultExplanation.textContent =
            `At a constant ${formatDecimal(result.bpm, 1)} bpm over ${formatDecimal(result.years, 2)} years, the mathematical estimate is ${compact} heartbeats. ${comparisonText}`;
        }

        if (resultExact) {
          resultExact.textContent =
            `Exact mathematical result: ${exact} heartbeats`;
        }

        result.copyText =
          `At a constant ${formatDecimal(result.bpm, 1)} bpm over ${formatDecimal(result.years, 2)} years, the estimated total is approximately ${compact} heartbeats (${exact} beats). This is a mathematical estimate, not a prediction of lifespan.`;
      } else {
        const compactBeats =
          formatCompactNumber(result.beats);

        const primaryYears =
          formatYearsPrimary(result.years);

        const detailedDuration =
          formatDetailedDuration(result.years);

        if (resultKicker) {
          resultKicker.textContent =
            'Equivalent time';
        }

        if (resultPrimary) {
          resultPrimary.textContent =
            `≈ ${primaryYears}`;
        }

        if (resultExplanation) {
          resultExplanation.textContent =
            `At a constant ${formatDecimal(result.bpm, 1)} bpm, reaching ${compactBeats} heartbeats would take approximately ${detailedDuration}.`;
        }

        if (resultExact) {
          resultExact.textContent =
            `Mathematical equivalent: ${preciseFormatter.format(result.years)} years`;
        }

        result.copyText =
          `At a constant ${formatDecimal(result.bpm, 1)} bpm, ${compactBeats} heartbeats would take approximately ${formatDecimal(result.years, 2)} years (${detailedDuration}). This is a mathematical equivalent, not a lifespan prediction.`;
      }

      renderScale(result.beats);
      renderScenarios(result);

      if (copyButton) {
        copyButton.disabled = false;
      }

      if (shareButton) {
        shareButton.disabled = false;
      }
    }

    function calculateEstimate() {
      try {
        const bpm = validateNumber(
          Number(estimateBpm?.value),
          LIMITS.bpmMin,
          LIMITS.bpmMax,
          'Heart rate'
        );

        const years = validateNumber(
          Number(estimateYears?.value),
          LIMITS.yearsMin,
          LIMITS.yearsMax,
          'Lifespan'
        );

        const beats =
          bpm *
          MINUTES_PER_YEAR *
          years;

        setMode('estimate');

        renderResult({
          mode: 'estimate',
          bpm,
          years,
          beats,
        });
      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : 'Please check the values and try again.'
        );
      }
    }

    function calculateConvert() {
      try {
        const beats = validateNumber(
          parseLooseNumber(convertBeats?.value),
          LIMITS.beatsMin,
          LIMITS.beatsMax,
          'Total heartbeats'
        );

        const bpm = validateNumber(
          Number(convertBpm?.value),
          LIMITS.bpmMin,
          LIMITS.bpmMax,
          'Heart rate'
        );

        const years =
          beats /
          (bpm * MINUTES_PER_YEAR);

        setMode('convert');

        renderResult({
          mode: 'convert',
          bpm,
          beats,
          years,
        });

        if (convertBeats) {
          convertBeats.value =
            formatExactBeats(beats);
        }
      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : 'Please check the values and try again.'
        );
      }
    }

    estimateForm?.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();
        calculateEstimate();
      }
    );

    convertForm?.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();
        calculateConvert();
      }
    );

    modeButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        setMode(
          button.dataset.modeButton,
          true
        );
      });

      button.addEventListener('keydown', (event) => {
        if (
          event.key !== 'ArrowLeft' &&
          event.key !== 'ArrowRight'
        ) {
          return;
        }

        event.preventDefault();

        const direction =
          event.key === 'ArrowRight' ? 1 : -1;

        const nextIndex =
          (index + direction + modeButtons.length) %
          modeButtons.length;

        modeButtons[nextIndex].focus();

        setMode(
          modeButtons[nextIndex].dataset.modeButton
        );
      });
    });

    root
      .querySelectorAll('[data-preset-mode]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const mode =
            button.dataset.presetMode;

          if (mode === 'estimate') {
            if (estimateBpm) {
              estimateBpm.value =
                button.dataset.presetBpm;
            }

            if (estimateYears) {
              estimateYears.value =
                button.dataset.presetYears;
            }

            setMode('estimate');
            calculateEstimate();
          }

          if (mode === 'convert') {
            if (convertBpm) {
              convertBpm.value =
                button.dataset.presetBpm;
            }

            if (convertBeats) {
              convertBeats.value =
                formatExactBeats(
                  Number(button.dataset.presetBeats)
                );
            }

            setMode('convert');
            calculateConvert();
          }
        });
      });

    copyButton?.addEventListener(
      'click',
      async () => {
        if (!currentResult) {
          return;
        }

        const url =
          buildShareUrl(currentResult);

        const text =
          `${currentResult.copyText} Calculated with the ClearHowGuide Lifetime Heartbeats Calculator: ${url}`;

        try {
          await copyToClipboard(text);
          announce('Result copied.');
        } catch {
          announce(
            'Could not copy automatically. Please copy the result manually.'
          );
        }
      }
    );

    shareButton?.addEventListener(
      'click',
      async () => {
        if (!currentResult) {
          return;
        }

        const url =
          buildShareUrl(currentResult);

        if (navigator.share) {
          try {
            await navigator.share({
              title:
                'ClearHowGuide Lifetime Heartbeats Calculator',
              text: currentResult.copyText,
              url,
            });

            announce('Share dialog opened.');
            return;
          } catch (error) {
            if (
              error instanceof DOMException &&
              error.name === 'AbortError'
            ) {
              return;
            }
          }
        }

        try {
          await copyToClipboard(url);
          announce(
            'Share link copied to the clipboard.'
          );
        } catch {
          announce(
            'Could not copy the share link automatically.'
          );
        }
      }
    );

    function loadFromQueryString() {
      const params =
        new URLSearchParams(window.location.search);

      const mode = params.get('mode');

      if (
        mode === 'estimate' &&
        params.has('bpm') &&
        params.has('years')
      ) {
        if (estimateBpm) {
          estimateBpm.value =
            params.get('bpm');
        }

        if (estimateYears) {
          estimateYears.value =
            params.get('years');
        }

        setMode('estimate');
        calculateEstimate();
        return;
      }

      if (
        mode === 'convert' &&
        params.has('bpm') &&
        params.has('beats')
      ) {
        if (convertBpm) {
          convertBpm.value =
            params.get('bpm');
        }

        if (convertBeats) {
          const beats =
            parseLooseNumber(
              params.get('beats')
            );

          convertBeats.value =
            Number.isFinite(beats)
              ? formatExactBeats(beats)
              : params.get('beats');
        }

        setMode('convert');
        calculateConvert();
        return;
      }

      setMode('estimate');
      calculateEstimate();
    }

    loadFromQueryString();
  }

  function initAllLifetimeHeartbeatsCalculators() {
    document
      .querySelectorAll('[data-lhc]')
      .forEach(initCalculator);
  }

  initAllLifetimeHeartbeatsCalculators();

  document.addEventListener(
    'astro:page-load',
    initAllLifetimeHeartbeatsCalculators
  );
</script>

